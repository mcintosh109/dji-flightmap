# Settings for the DJI Flight Map server.
# Installed to /etc/default/dji-flightmap - edit it there, then run:
#   systemctl restart dji-flightmap

# Folder (inside the container) that holds the decrypted flight logs.
# create-ct.sh shares the TrueNAS "archive" folder here.
DATA_DIR=/srv/dji-logs

# Port for the web page: http://<container-ip>:8080
PORT=8080

# How often (seconds) to look for new or changed log files.
SCAN_SECONDS=30

# Where flight summaries are remembered between restarts.
CACHE_FILE=/var/lib/dji-flightmap/summaries.json

# Login page: don't edit these by hand, run
#   bash /opt/dji-flightmap/deploy/set-login.sh
# SESSION_DAYS = how many days you stay signed in.
SESSION_DAYS=30
